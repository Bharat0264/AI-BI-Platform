# MongoDB is AURA-BI's primary persistent database. Use secret-managed values.
MONGODB_URI=mongodb+srv://USERNAME:PASSWORD@HOST/
MONGODB_DATABASE=aura_bi
# Optional connection windows for slower PaaS-to-Atlas networking (milliseconds).
MONGODB_SERVER_SELECTION_TIMEOUT_MS=15000
MONGODB_CONNECT_TIMEOUT_MS=10000
MONGODB_SOCKET_TIMEOUT_MS=20000
# Optional evidence narration.
AURA_ENABLE_LLM=false
GEMINI_API_KEY=your_optional_key
# Local HTTP defaults. Render automatically uses 0.0.0.0:$PORT and requires HTTPS account settings.
HOST=127.0.0.1
PORT=10000
# Account mode. Keep disabled only for isolated local legacy/demo evaluation.
AURA_AUTH_REQUIRED=true
# Required when account mode is enabled: generate a unique random secret (32+ characters).
AURA_SECRET_KEY=
# Local HTTP only. Set true behind HTTPS before any hosted use.
AURA_COOKIE_SECURE=false
